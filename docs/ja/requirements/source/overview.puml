@startuml overview
title Overview of collection
skinparam shadowing false
skinparam componentStyle rectangle

actor "Editor" as editor
file "Settings (TOML)" as settings
cloud "Source (arXiv)" as source

node "caraway" {
  [Scheduler] as scheduler
  [Collector] as collector
  database "PostgreSQL" as db {
    [Collection runs] as runs
    [Documents (candidates)] as documents
  }
}

editor --> settings : write sources and intervals
settings --> scheduler : read
scheduler --> runs : enqueue a run when the interval passes
collector --> runs : take a run, record success or failure
collector --> source : fetch bibliographic records,\nkeep the rules of the source
collector --> documents : save new records as candidates,\none per identifier
@enduml
