@startuml overview
title Overview of screening
skinparam shadowing false
skinparam componentStyle rectangle

actor "Editor" as editor
cloud "LLM" as llm

node "cardamap" {
  [Collection] as collection
  [Screening] as screening
  database "PostgreSQL" as db {
    [Topic definitions] as definitions
    [Documents waiting for screening] as waiting
    [Candidates\n(topics, rating, reason)] as candidates
    [Declined automatically\n(rating, reason)] as declined
    [Counts per period] as counts
  }
}

collection --> waiting : new documents (collected broadly)
editor --> definitions : write what each topic includes,\nexcludes, and what is worth reading
screening --> waiting : take
screening --> definitions : read
screening --> llm : title, abstract,\ntopic definitions
screening --> candidates : a topic applies and\nthe rating is high enough
screening --> declined : otherwise
editor --> candidates : accept or decline,\nhighest rating first
editor --> declined : check, move back to candidates
editor --> counts : read, then adjust the definitions
@enduml
